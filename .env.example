# ──────────────────────────────────────────────────────────────
# CLIENT-SIDE (Vite, prefixed VITE_*) — Firebase Web SDK config
# Found in Firebase Console → Project Settings → Your apps → Web app
# ──────────────────────────────────────────────────────────────

VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:abcdef
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# ──────────────────────────────────────────────────────────────
# SERVER-SIDE — Safaricom Daraja (M-Pesa STK Push)
# Get these from https://developer.safaricom.co.ke after registering
# your app and going through the production go-live process.
# ──────────────────────────────────────────────────────────────

MPESA_ENV=production                # 'sandbox' for testing, 'production' for live
MPESA_SHORTCODE=3429185             # till number — used as PartyB
                                    # for sandbox use 174379 (Safaricom's test PayBill)
# Optional — defaults to CustomerPayBillOnline when MPESA_ENV=sandbox,
# CustomerBuyGoodsOnline when MPESA_ENV=production. Override here if your
# till/paybill type doesn't match.
MPESA_TRANSACTION_TYPE=
MPESA_PASSKEY=your-lipa-na-mpesa-online-passkey
MPESA_CONSUMER_KEY=your-app-consumer-key
MPESA_CONSUMER_SECRET=your-app-consumer-secret
# Optional — defaults to https://skyview-grill.vercel.app/api/mpesa/callback
MPESA_CALLBACK_URL=
# Optional — only set if Safaricom issued you a distinct Head Office /
# Online Pay Shortcode for the app. Used as BusinessShortCode + password
# seed. Defaults to MPESA_SHORTCODE for tills that act as both.
MPESA_HEAD_OFFICE=

# ──────────────────────────────────────────────────────────────
# SERVER-SIDE — Firebase Admin SDK
# Used by /api/mpesa/callback to update order payment status.
# Easiest setup: paste the full service-account JSON (single line, no quotes
# stripped) into FIREBASE_SERVICE_ACCOUNT.
# Alternative: set the three fields individually (preserve \n escapes in the
# private key when pasting into a UI like Vercel).
# ──────────────────────────────────────────────────────────────

FIREBASE_SERVICE_ACCOUNT=
# or — instead of FIREBASE_SERVICE_ACCOUNT:
# FIREBASE_PROJECT_ID=skyview-grill
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@skyview-grill.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
